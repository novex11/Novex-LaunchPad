# Robinhood Chain (mainnet: chainId 4663, testnet: chainId 46630)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Set to true for testnet — uses mock tokens + contracts from testnet-deployments.json
NEXT_PUBLIC_USE_TESTNET=false
# Auto-refresh mock oracle feeds (uses DEPLOYER_PRIVATE_KEY from .env)
# ORACLE_REFRESH_INTERVAL_MS=1800000
# ORACLE_REFRESH_ON_START=true
# Minimum USD to create a basket (testnet default $10, mainnet $25). Stockback floor stays $100.
# NEXT_PUBLIC_BASKET_MIN_DEPOSIT_USD=10
# Optional: override RPC used by the browser for reads + receipt polling
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
# Block explorer URL (mainnet or testnet)
# Mainnet: https://explorer.robinhood.com
# Testnet: https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Alchemy (optional fallback RPC)
ALCHEMY_API_KEY=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Services
NEXT_PUBLIC_ALLOCATOR_URL=http://localhost:3001
NEXT_PUBLIC_QUOTE_URL=http://localhost:3002
NEXT_PUBLIC_INDEXER_URL=http://localhost:3003

# Verify each newly launched pair's contracts on the block explorer (indexer)
AUTO_VERIFY_CONTRACTS=true
# Blockscout API base; defaults to the active network's explorer
# EXPLORER_API_URL=https://explorer.testnet.chain.robinhood.com/api

# Price keeper: pushes live market prices to the on-chain PushPriceFeeds
# (pnpm keeper:testnet | keeper:mainnet | keeper:mainnet:dry). The key must be
# on the PriceFeedUpdater keeper allowlist; falls back to DEPLOYER_PRIVATE_KEY.
# KEEPER_PRIVATE_KEY=
# testnet (default) | mainnet — same as passing --mainnet
# KEEPER_NETWORK=testnet
# KEEPER_INTERVAL_MS=300000
# Re-push a feed once it is this old (default 1500 testnet / 2400 mainnet;
# OracleAdapter rejects feeds older than 3600s)
# KEEPER_HEARTBEAT_SECONDS=2400
# ...or when the price moved by this many bps (default 10 testnet / 50 mainnet)
# KEEPER_DEVIATION_BPS=50
ALLOCATOR_PORT=3001
QUOTE_PORT=3002
INDEXER_PORT=3003

# Contracts deploy
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
RIALTO_SWAP_ROUTER=

# ─── Canonical Robinhood Chain addresses (pre-existing, NOT deployed by us) ──
NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
NEXT_PUBLIC_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
NEXT_PUBLIC_UNISWAP_V3_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
NEXT_PUBLIC_UNISWAP_V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
NEXT_PUBLIC_UNISWAP_V3_QUOTER=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7

# ─── Deployed Compose contract addresses (from deployments-mainnet.json) ───
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_RECEIPT_TOKEN_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_PAIR_FACTORY_ADDRESS=
NEXT_PUBLIC_LAUNCHPAD_ZAP_ADDRESS=
NEXT_PUBLIC_ORACLE_ADAPTER_ADDRESS=

# Rialto Swap API (production execution venue on Robinhood Chain)
# When RIALTO_API_KEY is empty, the quote service uses a formula-based
# fallback that estimates prices without real order book data. To enable
# live swap routing, obtain a key from the Rialto team.
RIALTO_API_KEY=
# Integrator fee in bps (0 = no extra fee, max 50)
RIALTO_INTEGRATOR_FEE_BPS=0

# Database (Neon PostgreSQL — for cloud/production indexer)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Docker indexer uses local Postgres by default. Set this to Neon only if reachable from containers.
# INDEXER_DATABASE_URL=

# Optional: only needed for `pnpm docker:up:local-db` (local Postgres instead of Neon)
POSTGRES_USER=compose
POSTGRES_PASSWORD=compose
POSTGRES_DB=compose

# Indexer backend contract addresses (chain-listener + mark-to-market)
VAULT_CONTRACT_ADDRESS=
RECEIPT_TOKEN_CONTRACT_ADDRESS=
PAIR_FACTORY_ADDRESS=
MARK_TO_MARKET_INTERVAL_MS=60000

# Browser origins allowed by the backend services (comma-separated).
# Defaults to the Render web app plus localhost:3000/3004; "*" allows all.
# CORS_ORIGINS=https://compose-web.onrender.com,http://localhost:3000

# Internal API key for service-to-service auth (leave empty to disable)
INTERNAL_API_KEY=

# Redis (Redis Cloud) — stores uploaded pair cover images for the launchpad
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379

# Public URL of the indexer (used when returning uploaded image URLs)
PUBLIC_INDEXER_URL=http://localhost:3003
